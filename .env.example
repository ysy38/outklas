# Postgres connection. Empty uses the local embedded database in .data/
DATABASE_URL=

# Required in production for the local session cookie.
AUTH_SECRET=

# Supabase Auth. When both are set, login uses Supabase and profile id = auth user id.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails that receive the admin role on registration.
ADMIN_EMAILS=admin@ydslab.local

# iyzico. When either is empty, /odeme uses the development checkout.
IYZICO_API_KEY=
IYZICO_SECRET=

# 1 grants Pro to every signed-in user. Leave unset to exercise the free limit.
DEV_PRO=

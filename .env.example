# Production origin for canonical URLs, sitemap and structured data.
# Use apex only: https://outklas.com (never https://www.outklas.com).
NEXT_PUBLIC_SITE_URL=https://outklas.com

# Postgres connection. Optional when the Vercel Supabase integration sets POSTGRES_URL.
DATABASE_URL=

# Required in production for the local session cookie. Unused when Supabase Auth is configured.
AUTH_SECRET=

# Supabase Auth. The Vercel integration also provides SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails that receive the admin role on registration.
ADMIN_EMAILS=admin@ydslab.local

# iyzico. When either is empty, /odeme uses the development checkout.
IYZICO_API_KEY=
IYZICO_SECRET=

# Offline content-intelligence pipeline only (npm run analysis:*). Keep these in .env.local; never add them to Vercel.
# Model defaults live in pipeline/ai/config.ts.
AI_PROVIDER=
GEMINI_API_KEY=
ANALYZER_MODEL=
VERIFIER_MODEL=
GENERATOR_MODEL=
JUDGE_MODEL=
AI_MAX_RETRIES=

# 1 grants Pro to every signed-in user. Leave unset to exercise the free limit.
DEV_PRO=
